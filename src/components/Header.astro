---
// Persistent header: logo + 3 anchors + the audit CTA (the one conversion path).
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center no-underline" aria-label="XCap Factoring home">
      <Logo class="block h-7 w-auto min-[360px]:h-9 md:h-10" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      <a href="/#how-it-works" class="nav-link">How it works</a>
      <a href="/#industries" class="nav-link">Who it's for</a>
      <a href="/#faq" class="nav-link">FAQ</a>
    </nav>

    <a href="/audit" class="btn btn-primary whitespace-nowrap !px-5 !py-2.5 !text-[0.92rem]" data-magnetic>
      Audit my contract
    </a>
  </div>
</header>
