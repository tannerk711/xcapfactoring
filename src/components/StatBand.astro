---
// Navy proof band shell: one dark contrast band per page max. Grain + one light sweep.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<section class={`navy-band grain ${className}`}>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-[2] w-1/3 -skew-x-12 bg-gradient-to-r from-transparent via-white/[0.06] to-transparent"
    data-band-sweep
    aria-hidden="true"
  >
  </div>
  <div class="container-page section-pad relative z-[1]">
    <slot />
  </div>
</section>
