---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AfterPaint from '../components/AfterPaint.astro';
import { tracking } from '../config/tracking';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  bare?: boolean; // hide header/footer chrome (processing takeover pages never use it; kept for flexibility)
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/img/og-image.jpg',
  noindex = false,
  schema = [],
  bare = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://xcapfactoring.com');
const canonical = new URL(canonicalPath, site).href;
const ogAbs = new URL(ogImage, site).href;
const adsTagId = tracking.googleAds.tagId;

const baseSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'XCap Factoring',
    url: site.href,
    logo: new URL('/favicon.svg', site).href,
    description:
      'Factoring contract audits and placement. XCap Factoring reads your factoring agreement, computes your true effective rate, and places you with better terms when the math supports it.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'XCap Factoring',
    url: site.href,
  },
  ...schema,
];
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XCap Factoring" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {baseSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {
      /* Google tag (Google Ads). The stub queues config and events in the head;
         the gtag.js library is injected after first paint so it stays out of
         the LCP path. The lead conversion fires from the audit island on an
         accepted submit (src/lib/ads-conversion.ts), never on page load. */
      adsTagId && (
        <>
          <AfterPaint />
          <script is:inline define:vars={{ adsTagId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', adsTagId, { allow_enhanced_conversions: true });
            afterPaint(function () {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + adsTagId;
              document.head.appendChild(s);
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    {!bare && <Header />}
    <slot />
    {!bare && <Footer />}
    <script>
      // Ad-click attribution (gclid, utm_*, ValueTrack) captured on every page
      // into localStorage so the audit form can send it with the lead. Organic
      // visits store only the landing page + referrer.
      import { captureAttribution } from '../lib/attribution';
      captureAttribution();
    </script>
    <script>
      // Motion layer loads after idle, never blocks first paint, never loads under reduced motion.
      const boot = () => import('../scripts/motion').then((m) => m.init()).catch(() => {});
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => boot(), { timeout: 2500 });
        } else {
          setTimeout(boot, 1200);
        }
      }
    </script>
  </body>
</html>
