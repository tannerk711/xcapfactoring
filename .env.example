# XCap Factoring site environment. ALL of these are server-side only (read via
# process.env in /api/* routes). Never prefix any of them with PUBLIC_.

# Anthropic API key for the contract extraction call (claude-opus-5).
ANTHROPIC_API_KEY=

# Vercel Blob read-write token. Auto-injected on Vercel once a Blob store is
# attached to the project; set locally for `vercel dev` / test scripts.
BLOB_READ_WRITE_TOKEN=

# Lead webhook. A ZAPIER CATCH HOOK URL, never a GHL inbound webhook (standing
# rule). Fired once per lead, on submit, with the full TCPA consent record.
LEAD_WEBHOOK_URL=

# Przemek's completion notification. Also a ZAPIER CATCH HOOK URL. Receives the
# extracted-terms table, all flags, the factor name, and the contract link.
AUDIT_NOTIFY_WEBHOOK_URL=

# Bearer secret for /api/cron/cleanup (daily blob retention sweep).
CRON_SECRET=

# Optional: override the 90-day contract retention window.
# RETENTION_DAYS=90
